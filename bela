<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hi Bestie Test</title>
  <style>
    body{margin:0;background:#fff7f2;font-family:Arial,sans-serif}
    .box{max-width:420px;margin:40px auto;background:#fff;padding:24px;border-radius:24px;box-shadow:0 20px 40px rgba(0,0,0,.12);text-align:center}
    h1{margin:0 0 10px;font-size:26px;color:#111}
    p{margin:0;color:#333;font-size:16px;line-height:1.5}
    .btn{margin-top:14px;padding:14px;border-radius:18px;border:0;width:100%;font-weight:800;background:#ff8fab;color:#fff;cursor:pointer}
  </style>
</head>
<body>
  <div class="box">
    <h1 id="t">Loading…</h1>
    <p>✅ If you see this box, GitHub Pages is working.</p>
    <button class="btn" onclick="alert('Button works ✅')">YES ✅</button>
  </div>

  <script>
    const params = new URLSearchParams(location.search);
    const name = params.get("name") || "Gertlyn";
    document.getElementById("t").textContent = "Hey " + name + " 💕";
  </script>
</body>
</html>
