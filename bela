<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Just for you</title>

  <style>
    :root{
      --bg:#fff7f2; --card:#ffffff; --text:#222; --muted:#666;
      --pink:#ff8fab; --pink2:#ffd6e8; --shadow:0 20px 40px rgba(0,0,0,.12);
      --radius:30px;
    }
    body{margin:0;background:var(--bg);font-family:Arial,sans-serif;color:var(--text)}
    .container{max-width:420px;margin:auto;padding:20px}
    .card{background:var(--card);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow);text-align:center}
    h1{font-size:26px;margin:10px 0 8px}
    p{font-size:16px;color:var(--muted);line-height:1.5;margin:10px 0}
    .big{font-size:18px;color:#333;font-weight:700}
    .quote{margin:14px 0;padding:14px 16px;border-radius:18px;background:rgba(255,214,232,.55);color:#ff4d88;font-weight:800}
    .btn{display:block;margin-top:14px;padding:14px;border-radius:20px;font-weight:800;cursor:pointer;border:0;width:100%;font-size:16px}
    .yes{background:var(--pink);color:white}
    .ghost{background:var(--pink2);color:#ff4d88}
    .photo{width:100%;border-radius:22px;overflow:hidden;box-shadow:0 12px 24px rgba(0,0,0,.10);border:1px solid rgba(0,0,0,.06);margin-top:10px}
    .photo img{width:100%;height:auto;display:block}
    .hidden{display:none}
  </style>
</head>

<body>
  <div class="container">

    <!-- PAGE 1 -->
    <div class="card" id="page1">
      <h1 id="hey">Hey 💕</h1>
      <p>This page is made just for you.</p>

      <div class="quote">👭 “SO AYUN NA NGA!”</div>

      <p class="big">This will be better with your presence, do you want to see?</p>
      <button class="btn yes" id="yesBtn">YES ✅</button>
    </div>

    <!-- PAGE 2 -->
    <div class="card hidden" id="page2">
      <h1 id="title2">YAYYY 💖</h1>

      <div class="photo">
        <!-- ✅ Replace this image link with YOUR photo link -->
        <img src="https://imgur.com/a/yffiqYs" alt="Our photo">
      </div>

      <p style="margin-top:14px;">
        I love you and thank you for making my 2025 ugly and for being ugly also.
      </p>

      <div class="quote">eme</div>

      <p class="big">WILL YOU BE ONE OF MY BRIDESMAID</p>

      <button class="btn yes" onclick="finalYes()">YES I WILL 💍</button>
      <button class="btn ghost" onclick="back()">Go back</button>
    </div>

  </div>

<script>
  // Personalization: add ?name=Gertlyn
  const params = new URLSearchParams(location.search);
  const name = params.get("name") || "you";

  document.getElementById("hey").innerText = "Hey " + name + ", 💕";
  document.getElementById("title2").innerText = "YAYYY " + name + " 💖";

  document.getElementById("yesBtn").addEventListener("click", () => {
    document.getElementById("page1").classList.add("hidden");
    document.getElementById("page2").classList.remove("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  function back(){
    document.getElementById("page2").classList.add("hidden");
    document.getElementById("page1").classList.remove("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function finalYes(){
    alert("AAAAAA 😭💖 Thank you!!");
  }
</script>
</body>
</html>
